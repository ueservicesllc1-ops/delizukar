# ==================== PAYPAL CONFIGURATION ====================
# Configuración de PayPal para tu aplicación

# IMPORTANTE: Reemplaza estos valores con tus credenciales reales de PayPal
# Obtén tus credenciales desde: https://developer.paypal.com/developer/applications/

# ==================== CREDENCIALES DE DESARROLLO (SANDBOX) ====================
# Usa estas credenciales para desarrollo y pruebas
REACT_APP_PAYPAL_CLIENT_ID=tu_client_id_sandbox_aqui
PAYPAL_CLIENT_SECRET=tu_client_secret_sandbox_aqui

# ==================== CREDENCIALES DE PRODUCCIÓN (LIVE) ====================
# Descomenta y usa estas credenciales para producción
# REACT_APP_PAYPAL_CLIENT_ID=tu_client_id_live_aqui
# PAYPAL_CLIENT_SECRET=tu_client_secret_live_aqui

# ==================== CONFIGURACIÓN DE PAYPAL ====================
# Entorno de PayPal (sandbox para desarrollo, production para producción)
REACT_APP_PAYPAL_ENVIRONMENT=sandbox

# Moneda por defecto
REACT_APP_PAYPAL_CURRENCY=USD

# Intención de pago (capture para capturar inmediatamente, authorize para autorizar)
REACT_APP_PAYPAL_INTENT=capture

# ==================== INSTRUCCIONES DE CONFIGURACIÓN ====================
# 1. Copia este archivo como .env.local
# 2. Ve a https://developer.paypal.com/developer/applications/
# 3. Crea una nueva aplicación o usa una existente
# 4. Copia el Client ID y Client Secret a las variables correspondientes
# 5. Para producción, cambia REACT_APP_PAYPAL_ENVIRONMENT a "production"
# 6. Usa las credenciales de producción en lugar de las de sandbox

# ==================== NOTAS IMPORTANTES ====================
# - Las credenciales de sandbox son para pruebas y no procesan pagos reales
# - Las credenciales de producción procesan pagos reales
# - Nunca compartas tus credenciales de producción
# - Usa variables de entorno diferentes para desarrollo y producción









